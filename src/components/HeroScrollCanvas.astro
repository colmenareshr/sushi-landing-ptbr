---
// HeroScrollCanvas.astro - Scroll World Engine (Alimentado pela skill scroll-world)
// Implementa: Blob Loading + LERP Interpolation + Decoder Seeking Coalescing + Linger Easing
---

<section id="hero-scroll" class="relative w-full h-[400vh] bg-[#090B0E]">
  <!-- Viewport Fixo durante as 4 fases do Scroll World -->
  <div class="sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center">
    
    <!-- Video Stage com Camada de Vídeos em Blob -->
    <div class="absolute inset-0 z-0 bg-[#090B0E]" id="video-stage">
      <video id="v-clip-1" class="absolute inset-0 w-full h-full object-cover opacity-100 will-change-transform" muted playsinline preload="auto"></video>
      <video id="v-clip-2" class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" muted playsinline preload="auto"></video>
      <video id="v-clip-3" class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" muted playsinline preload="auto"></video>
      <video id="v-clip-4" class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" muted playsinline preload="auto"></video>

      <!-- Overlay Cinematográfico com Gradiente Suave para Legibilidade Extrema -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#090B0E] via-[#090B0E]/65 to-[#090B0E]/75 pointer-events-none"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_15%,_#090B0E_90%)] pointer-events-none"></div>
    </div>

    <!-- Indicador Lateral de Rota (Navegação Interativa de 4 Cenas) -->
    <div class="hidden lg:flex flex-col gap-6 absolute right-8 top-1/2 -translate-y-1/2 z-30 font-mono text-xs tracking-widest">
      <button type="button" class="route-node flex items-center gap-3 text-left focus:outline-none transition-all duration-300" data-index="0">
        <span class="w-2.5 h-2.5 rounded-full border border-[#D4AF37] bg-[#D4AF37] transition-all"></span>
        <span class="text-white text-[11px] uppercase tracking-wider">01 · A Chegada</span>
      </button>
      <button type="button" class="route-node flex items-center gap-3 text-left focus:outline-none transition-all duration-300 opacity-40" data-index="1">
        <span class="w-2.5 h-2.5 rounded-full border border-[#D4AF37] bg-transparent transition-all"></span>
        <span class="text-white text-[11px] uppercase tracking-wider">02 · O Salão</span>
      </button>
      <button type="button" class="route-node flex items-center gap-3 text-left focus:outline-none transition-all duration-300 opacity-40" data-index="2">
        <span class="w-2.5 h-2.5 rounded-full border border-[#D4AF37] bg-transparent transition-all"></span>
        <span class="text-white text-[11px] uppercase tracking-wider">03 · Balcão Omakase</span>
      </button>
      <button type="button" class="route-node flex items-center gap-3 text-left focus:outline-none transition-all duration-300 opacity-40" data-index="3">
        <span class="w-2.5 h-2.5 rounded-full border border-[#D4AF37] bg-transparent transition-all"></span>
        <span class="text-white text-[11px] uppercase tracking-wider">04 · Pratos de Autor</span>
      </button>
    </div>

    <!-- Camadas de Copywriting (Uma para cada etapa do vôo de câmera) -->
    <div class="relative z-20 max-w-5xl mx-auto px-6 text-center flex flex-col items-center">
      
      <!-- CENA 1: A Chegada / Hero Principal -->
      <article class="scene-copy transition-all duration-500 max-w-3xl opacity-100" id="copy-0">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-[#D4AF37]/30 bg-[#161B24]/85 backdrop-blur-md mb-8">
          <span class="w-2 h-2 rounded-full bg-[#D4AF37] animate-pulse"></span>
          <span class="text-[11px] font-mono tracking-[0.25em] text-[#F3E5AB] uppercase">
            01 / Experiência Omakase Exclusiva
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.08] mb-6">
          A arte do sushi contemporâneo em <span class="bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#D4AF37] bg-clip-text text-transparent">Curitiba</span>.
        </h1>

        <p class="text-base sm:text-xl text-slate-300 font-light leading-relaxed mb-10 max-w-2xl mx-auto">
          Peixes nobres maturados a seco, técnica milenar japonesa e uma jornada sensorial imersiva para apenas 12 convidados por sessão no Batel.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full">
          <a
            href="https://wa.me/5541999999999?text=Ol%C3%A1!%20Gostaria%20de%20consultar%20disponibilidade%20para%20o%20Omakase%20no%20Kuro"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-sm font-semibold tracking-widest uppercase bg-gradient-to-r from-[#D4AF37] to-[#B38F24] text-[#090B0E] hover:from-[#F3E5AB] hover:to-[#D4AF37] shadow-[0_0_30px_rgba(212,175,55,0.35)] hover:shadow-[0_0_40px_rgba(212,175,55,0.6)] transition-all duration-300 transform hover:-translate-y-1"
          >
            <span>Reservar pelo WhatsApp</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#omakase"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-semibold tracking-widest uppercase border border-white/20 text-white hover:border-[#D4AF37] hover:text-[#D4AF37] bg-black/40 backdrop-blur-sm transition-all duration-300"
          >
            Ver os Menus
          </a>
        </div>

        <div class="mt-12 flex items-center justify-center gap-2 text-xs font-mono tracking-widest text-[#D4AF37]/80 uppercase animate-bounce">
          <span>Role para explorar o restaurante</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </article>

      <!-- CENA 2: O Salão -->
      <article class="scene-copy hidden opacity-0 transition-all duration-500 max-w-2xl" id="copy-1">
        <span class="text-xs font-mono tracking-[0.3em] text-[#D4AF37] uppercase block mb-3">
          02 / Atmosfera e Arquitetura
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Silêncio, madeira nobre e penumbra acolhedora.
        </h2>
        <p class="text-slate-300 text-base sm:text-lg font-light leading-relaxed">
          Inspirado na arquitetura Wabi-Sabi com madeira carbonizada Yakisugi e lanternas artesanais de papel Washi. Um refúgio intimista no coração do Batel.
        </p>
      </article>

      <!-- CENA 3: O Balcão Omakase -->
      <article class="scene-copy hidden opacity-0 transition-all duration-500 max-w-2xl" id="copy-2">
        <span class="text-xs font-mono tracking-[0.3em] text-[#D4AF37] uppercase block mb-3">
          03 / O Balcão de 12 Lugares
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Frente a frente com o mestre sushiman.
        </h2>
        <p class="text-slate-300 text-base sm:text-lg font-light leading-relaxed">
          Cada peça é moldada à mão em tempo real, na temperatura exata do corpo humano, e servida diretamente sobre pedra ardósia vulcânica.
        </p>
      </article>

      <!-- CENA 4: A Criação de Autor -->
      <article class="scene-copy hidden opacity-0 transition-all duration-500 max-w-2xl" id="copy-3">
        <span class="text-xs font-mono tracking-[0.3em] text-[#D4AF37] uppercase block mb-3">
          04 / Alta Gastronomia
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Peixes maturados no ponto exato de Umami.
        </h2>
        <p class="text-slate-300 text-base sm:text-lg font-light leading-relaxed">
          Bluefin Otoro, Vieiras de Hokkaido, Ouriço-do-Mar e Wagyu A5 com lâminas de trufa branca e flor de sal Maldon.
        </p>
      </article>

    </div>

    <!-- Badges de Prova Social Inferiores -->
    <div class="absolute bottom-6 left-0 right-0 z-30 max-w-6xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4 text-xs font-mono tracking-wider text-slate-400">
      <div class="flex items-center gap-2">
        <span class="text-[#D4AF37]">★★★★★</span>
        <span class="text-slate-200">4.9 no Google</span>
        <span class="text-slate-500">(180+ avaliações verificadas)</span>
      </div>
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Apenas 12 assentos por sessão
        </span>
        <span class="hidden sm:inline text-slate-500">·</span>
        <span class="hidden sm:inline">Av. Batel, Curitiba</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Motor Avançado Scroll-World (Técnica do scrub-engine.js)
  // LERP interpolation + Coalesced Seeking + Blob Preload + Linger Easing
  
  const heroSection = document.getElementById('hero-scroll');
  if (heroSection) {
    const isMobile = window.matchMedia('(hover: none) and (pointer: coarse)').matches || window.innerWidth < 860;
    const eps = isMobile ? 0.025 : 0.008; // precisão do decoder

    // Definição dos segmentos de vídeo
    const clipSources = [
      { webm: '/videos/clip1.webm', mp4: '/videos/clip1.mp4' },
      { webm: '/videos/clip2.webm', mp4: '/videos/clip2.mp4' },
      { webm: '/videos/clip3.webm', mp4: '/videos/clip3.mp4' },
      { webm: '/videos/clip4.webm', mp4: '/videos/clip4.mp4' }
    ];

    const videoElements = [
      document.getElementById('v-clip-1') as HTMLVideoElement,
      document.getElementById('v-clip-2') as HTMLVideoElement,
      document.getElementById('v-clip-3') as HTMLVideoElement,
      document.getElementById('v-clip-4') as HTMLVideoElement
    ];

    const copies = [
      document.getElementById('copy-0'),
      document.getElementById('copy-1'),
      document.getElementById('copy-2'),
      document.getElementById('copy-3')
    ];

    const routeNodes = Array.from(document.querySelectorAll('.route-node'));

    // Estrutura de estado de cada cena para interpolação suave
    const scenes = videoElements.map((v, i) => ({
      video: v,
      ready: false,
      cur: 0,
      target: 0,
      visible: i === 0
    }));

    // Função de carregamento via Blob (chave para scrubbing sem latência)
    function loadVideoBlob(index: number) {
      const src = clipSources[index];
      const video = videoElements[index];
      if (!src || !video) return;

      const url = video.canPlayType('video/webm; codecs="vp9"') ? src.webm : src.mp4;
      
      fetch(url)
        .then(res => res.ok ? res.blob() : Promise.reject('Erro ao carregar'))
        .then(blob => {
          video.src = URL.createObjectURL(blob);
          video.addEventListener('loadedmetadata', () => {
            scenes[index].ready = true;
          });
        })
        .catch(() => {
          // Fallback para URL direta se fetch falhar
          video.src = url;
          scenes[index].ready = true;
        });
    }

    // Carregar todos os 4 clips na memória
    scenes.forEach((_, idx) => loadVideoBlob(idx));

    // Linger Easing: desacelera a câmera no centro da cena para leitura do texto
    const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const smooth = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
    const lingerEase = (x: number, L = 0.45) => {
      const c = x - 0.5;
      return (1 - L) * x + L * (4 * c * c * c + 0.5);
    };

    let activeSceneIndex = 0;

    // Cálculo da posição no scroll
    function onScrollUpdate() {
      if (!heroSection) return;
      const rect = heroSection.getBoundingClientRect();
      const totalScrollable = heroSection.offsetHeight - window.innerHeight;
      const currentScroll = Math.max(0, -rect.top);
      const progress = clamp(currentScroll / totalScrollable, 0, 0.999);

      // Cada um dos 4 vídeos cobre 25% do scroll
      const segmentWidth = 1 / 4;
      const currentSegment = Math.min(3, Math.floor(progress / segmentWidth));
      activeSceneIndex = currentSegment;

      scenes.forEach((s, idx) => {
        // Progresso local dentro do clip (0.0 a 1.0)
        const local = clamp((progress - idx * segmentWidth) / segmentWidth, 0, 1);
        s.target = lingerEase(local, 0.45);

        // Crossfade suave de opacidade entre clips
        const distFromCenter = Math.abs(progress - (idx * segmentWidth + segmentWidth / 2));
        const opacity = smooth(1 - (distFromCenter - segmentWidth * 0.25) / (segmentWidth * 0.35));
        
        s.visible = opacity > 0.01;
        if (s.video) {
          s.video.style.opacity = String(opacity);
          s.video.style.pointerEvents = opacity > 0.5 ? 'auto' : 'none';
        }
      });

      // Atualizar textos e marcadores
      copies.forEach((copy, idx) => {
        if (!copy) return;
        if (idx === currentSegment) {
          copy.classList.remove('hidden');
          setTimeout(() => copy.classList.remove('opacity-0'), 20);
        } else {
          copy.classList.add('opacity-0');
          setTimeout(() => copy.classList.add('hidden'), 350);
        }
      });

      routeNodes.forEach((node, idx) => {
        const dot = node.querySelector('span:first-child');
        if (idx === currentSegment) {
          node.classList.remove('opacity-40');
          dot?.classList.add('bg-[#D4AF37]');
          dot?.classList.remove('bg-transparent');
        } else {
          node.classList.add('opacity-40');
          dot?.classList.remove('bg-[#D4AF37]');
          dot?.classList.add('bg-transparent');
        }
      });
    }

    // Loop de RAF com LERP e Seeking Coalescing (o segredo do scrub-engine.js)
    function rafLoop() {
      for (let i = 0; i < scenes.length; i++) {
        const s = scenes[i];
        if (!s.ready || !s.video) continue;

        // CRUCIAL: Se o decodificador de vídeo ainda está ocupado resolvendo o frame anterior,
        // NÃO mande outra busca! Aguarde a liberação para evitar congelamentos e engasgos.
        if (s.video.seeking) continue;

        if (!s.visible && Math.abs(s.cur - s.target) < 0.002) continue;

        // Interpolação linear suave (LERP) a 18% por frame
        s.cur += (s.target - s.cur) * 0.18;
        
        const dur = s.video.duration || 1;
        const targetTime = clamp(s.cur, 0, 0.999) * dur;

        if (Math.abs(s.video.currentTime - targetTime) > eps) {
          try {
            s.video.currentTime = targetTime;
          } catch (e) {}
        }
      }
      requestAnimationFrame(rafLoop);
    }

    // Suporte para iOS: destrava os vídeos no primeiro toque
    function primeVideos() {
      scenes.forEach(s => {
        if (s.video) {
          try {
            const p = s.video.play();
            if (p && p.then) p.then(() => s.video.pause()).catch(() => {});
          } catch (e) {}
        }
      });
    }
    window.addEventListener('pointerdown', primeVideos, { once: true, passive: true });
    window.addEventListener('touchstart', primeVideos, { once: true, passive: true });

    // Clique nos nós laterais para saltar suavemente para a cena
    routeNodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        const totalScrollable = heroSection.offsetHeight - window.innerHeight;
        const targetScroll = heroSection.offsetTop + (idx * 0.25 + 0.125) * totalScrollable;
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      });
    });

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScrollUpdate();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    onScrollUpdate();
    requestAnimationFrame(rafLoop);
  }
</script>
