        <span class="text-white text-[11px] uppercase tracking-wider">02 · O Salão</span>
      </button>
      <button type="button" class="route-node flex items-center gap-3 text-left focus:outline-none transition-all duration-300 opacity-40" data-index="2">
        <span class="w-2.5 h-2.5 rounded-full border border-[#D4AF37] bg-transparent transition-all"></span>
        <span class="text-white text-[11px] uppercase tracking-wider">03 · Balcão Omakase</span>
      </button>
      <button type="button" class="route-node flex items-center gap-3 text-left focus:outline-none transition-all duration-300 opacity-40" data-index="3">
        <span class="w-2.5 h-2.5 rounded-full border border-[#D4AF37] bg-transparent transition-all"></span>
        <span class="text-white text-[11px] uppercase tracking-wider">04 · Pratos de Autor</span>
      </button>
    </div>

    <!-- Camadas de Copywriting: Ancoradas no canto inferior esquerdo para liberar a visão dos vídeos -->
    <div class="absolute bottom-12 sm:bottom-16 lg:bottom-20 left-6 sm:left-12 lg:left-16 z-20 max-w-xl sm:max-w-2xl text-left pointer-events-none pr-6">
      <div class="grid grid-cols-1 grid-rows-1 items-end">
        
        <!-- CENA 1: A Chegada / Hero Principal -->
        <article class="scene-copy col-start-1 row-start-1 transition-all duration-500 opacity-100 pointer-events-auto" id="copy-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#D4AF37]/30 bg-[#090B0E]/80 backdrop-blur-md mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37] animate-pulse"></span>
            <span class="text-[10px] sm:text-[11px] font-mono tracking-[0.2em] text-[#F3E5AB] uppercase">
              Sessão Noturna Exclusiva · 12 Lugares
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.1] mb-3">
            O verdadeiro Omakase no Batel. <span class="bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#D4AF37] bg-clip-text text-transparent">Sem pressa. Sem concessões.</span>
          </h1>

          <p class="text-xs sm:text-sm md:text-base text-slate-200 font-light leading-relaxed mb-4 max-w-lg">
            Peixes nobres com até 14 dias de maturação a seco e arroz temperado com vinagre Akazu centenário. Uma experiência íntima diante do sushiman.
          </p>

          <div class="flex flex-col items-start gap-2.5">
            <div class="flex flex-wrap items-center gap-3">
              <a
                href="https://wa.me/5541999999999?text=Ol%C3%A1!%20Gostaria%20de%20consultar%20disponibilidade%20para%20o%20Omakase%20no%20Kuro"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 rounded-full text-xs font-semibold tracking-wider uppercase bg-gradient-to-r from-[#D4AF37] to-[#B38F24] text-[#090B0E] hover:from-[#F3E5AB] hover:to-[#D4AF37] shadow-[0_0_20px_rgba(212,175,55,0.35)] transition-all duration-300 transform hover:-translate-y-0.5"
              >
                <span>Quero reservar no WhatsApp</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href="#omakase"
                class="inline-flex items-center justify-center px-4 py-2.5 sm:px-5 sm:py-3 rounded-full text-xs font-semibold tracking-wider uppercase border border-white/20 text-white hover:border-[#D4AF37] hover:text-[#D4AF37] bg-black/40 backdrop-blur-sm transition-all duration-300"
              >
                Ver os 3 Menus
              </a>
            </div>
            
            <!-- Click Trigger Joanna Wiebe (neutralizador de fricção) -->
            <span class="text-[10px] sm:text-[11px] font-mono text-slate-300 tracking-wider">
              ✓ Sem cobrança de cancelamento até 24h · Resposta rápida pelo Concierge
            </span>
          </div>

          <div class="mt-4 flex items-center gap-2 text-[10px] sm:text-[11px] font-mono tracking-widest text-[#D4AF37]/90 uppercase animate-bounce">
            <span>Role para explorar o restaurante</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>
        </article>

        <!-- CENA 2: O Salão -->
        <article class="scene-copy col-start-1 row-start-1 hidden opacity-0 transition-all duration-500 pointer-events-auto max-w-lg p-5 sm:p-6 rounded-2xl bg-[#090B0E]/80 backdrop-blur-md border border-white/10 shadow-2xl" id="copy-1">
          <span class="text-[10px] sm:text-[11px] font-mono tracking-[0.25em] text-[#D4AF37] uppercase block mb-1.5 font-semibold">
            02 · Atmosfera e Arquitetura
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white leading-tight mb-2">
            Madeira carbonizada, lanternas Washi e silêncio.
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm font-light leading-relaxed">
            Um refúgio acolhedor no Batel. Sem música alta. Sem mesas coladas. Apenas iluminação cênica pontual e o calor da madeira natural.
          </p>
        </article>

        <!-- CENA 3: O Balcão Omakase -->
        <article class="scene-copy col-start-1 row-start-1 hidden opacity-0 transition-all duration-500 pointer-events-auto max-w-lg p-5 sm:p-6 rounded-2xl bg-[#090B0E]/80 backdrop-blur-md border border-white/10 shadow-2xl" id="copy-2">
          <span class="text-[10px] sm:text-[11px] font-mono tracking-[0.25em] text-[#D4AF37] uppercase block mb-1.5 font-semibold">
            03 · O Balcão de 12 Lugares
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white leading-tight mb-2">
            12 lugares diante da lâmina do sushiman.
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm font-light leading-relaxed">
            Cada nigiri é moldado à mão na temperatura exata da palma. Da tábua à sua mão em segundos, servido sobre ardósia vulcânica aquecida.
          </p>
        </article>

        <!-- CENA 4: A Criação de Autor -->
        <article class="scene-copy col-start-1 row-start-1 hidden opacity-0 transition-all duration-500 pointer-events-auto max-w-lg p-5 sm:p-6 rounded-2xl bg-[#090B0E]/80 backdrop-blur-md border border-white/10 shadow-2xl" id="copy-3">
          <span class="text-[10px] sm:text-[11px] font-mono tracking-[0.25em] text-[#D4AF37] uppercase block mb-1.5 font-semibold">
            04 · Criações de Autor
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white leading-tight mb-2">
            Peixes maturados no ponto máximo de Umami.
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm font-light leading-relaxed">
            Bluefin Otoro que derrete na boca, vieiras frescas de Hokkaido, ouriço-do-mar e Wagyu A5 finalizado com flor de sal e trufa branca.
          </p>
        </article>

      </div>
    </div>

    <!-- Badges de Prova Social Inferiores (Ancorados à Direita) -->
    <div class="absolute bottom-5 right-6 sm:right-12 lg:right-16 z-30 hidden md:flex items-center gap-3 text-[11px] font-mono tracking-wider text-slate-300 bg-[#090B0E]/75 border border-white/10 px-4 py-2 rounded-full backdrop-blur-md">
      <div class="flex items-center gap-1.5">
        <span class="text-[#D4AF37]">★★★★★</span>
        <span class="text-white font-medium">4.9 no Google</span>
        <span class="text-slate-400">(180+ avaliações)</span>
      </div>
      <span class="text-white/20">·</span>
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>12 assentos por sessão</span>
      </div>
      <span class="text-white/20">·</span>
      <span class="text-slate-400">Batel, Curitiba</span>
    </div>
  </div>
</section>

<script>
  // Motor Avançado Scroll-World (Técnica do scrub-engine.js)
  // LERP interpolation + Coalesced Seeking + Blob Preload + Linger Easing
  
  const heroSection = document.getElementById('hero-scroll');
  if (heroSection) {
    const isMobile = window.matchMedia('(hover: none) and (pointer: coarse)').matches || window.innerWidth < 860;
    const eps = isMobile ? 0.025 : 0.008; // precisão do decoder

    // Definição dos segmentos de vídeo
    const clipSources = [
      { webm: '/videos/clip1.webm', mp4: '/videos/clip1.mp4' },
      { webm: '/videos/clip2.webm', mp4: '/videos/clip2.mp4' },
      { webm: '/videos/clip3.webm', mp4: '/videos/clip3.mp4' },
      { webm: '/videos/clip4.webm', mp4: '/videos/clip4.mp4' }
    ];

    const videoElements = [
      document.getElementById('v-clip-1') as HTMLVideoElement,
      document.getElementById('v-clip-2') as HTMLVideoElement,
      document.getElementById('v-clip-3') as HTMLVideoElement,
      document.getElementById('v-clip-4') as HTMLVideoElement
    ];

    const copies = [
      document.getElementById('copy-0'),
      document.getElementById('copy-1'),
      document.getElementById('copy-2'),
      document.getElementById('copy-3')
    ];

    const routeNodes = Array.from(document.querySelectorAll('.route-node'));

    // Estrutura de estado de cada cena para interpolação suave
    const scenes = videoElements.map((v, i) => ({
      video: v,
      ready: false,
      cur: 0,
      target: 0,
      visible: i === 0
    }));

    // Função de carregamento via Blob (chave para scrubbing sem latência)
    function loadVideoBlob(index: number) {
      const src = clipSources[index];
      const video = videoElements[index];
      if (!src || !video) return;

      const url = video.canPlayType('video/webm; codecs="vp9"') ? src.webm : src.mp4;
      
      fetch(url)
        .then(res => res.ok ? res.blob() : Promise.reject('Erro ao carregar'))
        .then(blob => {
          video.src = URL.createObjectURL(blob);
          video.addEventListener('loadedmetadata', () => {
            scenes[index].ready = true;
          });
        })
        .catch(() => {
          // Fallback para URL direta se fetch falhar
          video.src = url;
          scenes[index].ready = true;
        });
    }

    // Carregar todos os 4 clips na memória
    scenes.forEach((_, idx) => loadVideoBlob(idx));

    // Linger Easing: desacelera a câmera no centro da cena para leitura do texto
    const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const smooth = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
    const lingerEase = (x: number, L = 0.45) => {
      const c = x - 0.5;
      return (1 - L) * x + L * (4 * c * c * c + 0.5);
    };

    let activeSceneIndex = 0;

    // Cálculo da posição no scroll
    function onScrollUpdate() {
      if (!heroSection) return;
      const rect = heroSection.getBoundingClientRect();
      const totalScrollable = heroSection.offsetHeight - window.innerHeight;
      const currentScroll = Math.max(0, -rect.top);
      const progress = clamp(currentScroll / totalScrollable, 0, 0.999);

      // Cada um dos 4 vídeos cobre 25% do scroll
      const segmentWidth = 1 / 4;
      const currentSegment = Math.min(3, Math.floor(progress / segmentWidth));
      activeSceneIndex = currentSegment;

      scenes.forEach((s, idx) => {
        // Progresso local dentro do clip (0.0 a 1.0)
        const local = clamp((progress - idx * segmentWidth) / segmentWidth, 0, 1);
        s.target = lingerEase(local, 0.45);

        // Crossfade suave de opacidade entre clips
        const distFromCenter = Math.abs(progress - (idx * segmentWidth + segmentWidth / 2));
        const opacity = smooth(1 - (distFromCenter - segmentWidth * 0.25) / (segmentWidth * 0.35));
        
        s.visible = opacity > 0.01;
        if (s.video) {
          s.video.style.opacity = String(opacity);
          s.video.style.pointerEvents = opacity > 0.5 ? 'auto' : 'none';
        }
      });

      // Atualizar textos e marcadores sem race conditions
      copies.forEach((copy, idx) => {
        if (!copy) return;
        if (idx === currentSegment) {
          copy.classList.remove('hidden');
          requestAnimationFrame(() => {
            copy.classList.remove('opacity-0');
            copy.classList.add('opacity-100');
          });
        } else {
          copy.classList.remove('opacity-100');
          copy.classList.add('opacity-0');
          setTimeout(() => {
            if (activeSceneIndex !== idx) {
              copy.classList.add('hidden');
            }
          }, 350);
        }
      });

      routeNodes.forEach((node, idx) => {
        const dot = node.querySelector('span:first-child');
        if (idx === currentSegment) {
          node.classList.remove('opacity-40');
          dot?.classList.add('bg-[#D4AF37]');
          dot?.classList.remove('bg-transparent');
        } else {
          node.classList.add('opacity-40');
          dot?.classList.remove('bg-[#D4AF37]');
          dot?.classList.add('bg-transparent');
        }
      });
    }

    // Loop de RAF com LERP e Seeking Coalescing (o segredo do scrub-engine.js)
    function rafLoop() {
      for (let i = 0; i < scenes.length; i++) {
        const s = scenes[i];
        if (!s.ready || !s.video) continue;

        // CRUCIAL: Se o decodificador de vídeo ainda está ocupado resolvendo o frame anterior,
        // NÃO mande outra busca! Aguarde a liberação para evitar congelamentos e engasgos.
        if (s.video.seeking) continue;

        if (!s.visible && Math.abs(s.cur - s.target) < 0.002) continue;

        // Interpolação linear suave (LERP) a 18% por frame
        s.cur += (s.target - s.cur) * 0.18;
        
        const dur = s.video.duration || 1;
        const targetTime = clamp(s.cur, 0, 0.999) * dur;

        if (Math.abs(s.video.currentTime - targetTime) > eps) {
          try {
            s.video.currentTime = targetTime;
          } catch (e) {}
        }
      }
      requestAnimationFrame(rafLoop);
    }

    // Suporte para iOS: destrava os vídeos no primeiro toque
    function primeVideos() {
      scenes.forEach(s => {
        if (s.video) {
          try {
            const p = s.video.play();
            if (p && p.then) p.then(() => s.video.pause()).catch(() => {});
          } catch (e) {}
        }
      });
    }
    window.addEventListener('pointerdown', primeVideos, { once: true, passive: true });
    window.addEventListener('touchstart', primeVideos, { once: true, passive: true });

    // Clique nos nós laterais para saltar suavemente para a cena
    routeNodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        const totalScrollable = heroSection.offsetHeight - window.innerHeight;
        const targetScroll = heroSection.offsetTop + (idx * 0.25 + 0.125) * totalScrollable;
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      });
    });

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScrollUpdate();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    onScrollUpdate();
    requestAnimationFrame(rafLoop);
  }
</script>
