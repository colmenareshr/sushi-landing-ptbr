---
// HeroScrollCanvas.astro - Scroll World Engine (Alimentado pela skill scroll-world)
// Implementa: Blob Loading + LERP Interpolation + Decoder Seeking Coalescing + Linger Easing
---

<section id="hero-scroll" class="relative w-full h-[400vh] bg-[#090B0E]">
  <!-- Viewport Fixo durante as 4 fases do Scroll World -->
  <div class="sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center">
    
    <!-- Video Stage com Camada de Vídeos em Blob -->
    <div class="absolute inset-0 z-0 bg-[#090B0E]" id="video-stage">
      <video id="v-clip-1" class="absolute inset-0 w-full h-full object-cover opacity-100 will-change-transform" muted playsinline preload="auto"></video>
      <video id="v-clip-2" class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" muted playsinline preload="auto"></video>
      <video id="v-clip-3" class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" muted playsinline preload="auto"></video>
      <video id="v-clip-4" class="absolute inset-0 w-full h-full object-cover opacity-0 will-change-transform" muted playsinline preload="auto"></video>

      <!-- Overlay Cinematográfico Leve: Claridade Máxima para Vídeos e Transições -->
      <!-- Scrim inferior direcionado para contraste do texto sem escurecer a cena -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#090B0E]/80 via-[#090B0E]/15 to-transparent pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#090B0E]/70 via-transparent to-transparent w-full sm:w-1/2 pointer-events-none"></div>
